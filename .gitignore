# Build output
desktop/target/
*.exe
*.dll
*.obj
*.pdb
*.lib
*.exp
*.ilk
*.next.*
*.rollback*
*.bak
*.bak-*
build-manifest.json

# Runtime, models and third-party binaries (fetched or built separately)
runtime/*
/Anki/
!runtime/NODE-LICENSE.txt
models/
*.gguf

# User data, logs, caches
data/
logs/
cache/
*.sqlite
*.db
*.log
*.tomebak

# Test output
validation/*
!validation/*.test.cjs
!validation/helpers/
!validation/helpers/*.cjs
# per-game replay fixtures of the layered profiles (core/profiles, validation/games-regression.test.cjs)
!validation/fixtures/
validation/fixtures/*
!validation/fixtures/games/
!validation/fixtures/games/**
# engine-draw signature fixtures: a few hundred bytes of code around each matched call + the exe SHA-256 (no script text)
!validation/fixtures/engine-sigs/
!validation/fixtures/engine-sigs/**
# Weblio page markup with placeholder text for services/weblio-dictionary.cjs (#1110)
!validation/fixtures/weblio/
!validation/fixtures/weblio/*.html
# Small GPL upstream LiveMaker format fixtures, individually pinned in manifest.json
!validation/fixtures/livemaker/
!validation/fixtures/livemaker/test.dat
!validation/fixtures/livemaker/test.exe
!validation/fixtures/livemaker/00000001.lsb
!validation/fixtures/livemaker/gamemain.lsb
!validation/fixtures/livemaker/COPYING
!validation/fixtures/livemaker/manifest.json
validation/**/results*/
validation/**/*-profile-*/

# Generated file that embeds a locally extracted font
web/reader/modules/local-font.js

# Local working notes
handoff/
HANDOFF-*.md
CLAUDE-HANDOFF*.md
IMPLEMENTATION-*.md
MIGRATION-STATUS-*.md
TASKS-*.md

# OS / editor
Thumbs.db
.DS_Store
